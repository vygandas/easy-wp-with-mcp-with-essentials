# Local development. docker/start.ps1 creates .env with unique salts automatically.
# Or copy to .env (git-ignored) and fill in the salts yourself.
# In production, set the same variable names in your host's environment settings; see README.md.

WP_ENVIRONMENT_TYPE=local
WP_HOME=https://localhost:8443
WP_DEBUG=true

# Host ports published by Caddy. Not 80/443, so the stack can run beside another local web server.
HTTP_PORT=8080
HTTPS_PORT=8443

# Database as seen from inside the container (compose service name "db").
DB_HOST=db
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_ROOT_PASSWORD=root
DB_TABLE_PREFIX=wp_
# Host-side port for GUI clients. Not 3306, so it can run beside a local MySQL.
DB_PORT_HOST=3307

# Salts: required, unique per environment. https://api.wordpress.org/secret-key/1.1/salt/
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# Local auto-login (wp-content/mu-plugins/local-dev-login.php). 16+ URL-safe characters, e.g. `openssl rand -hex 16`.
# Open https://localhost:8443/wp-login.php?local-login=<LOCAL_LOGIN_TOKEN>, or run docker/login.ps1.
LOCAL_LOGIN_TOKEN=
# Optional: login or email of the account to sign in as. Default: the first administrator.
LOCAL_LOGIN_USER=

# Media storage: an S3-compatible bucket, mandatory in production (the container disk is wiped on
# every deploy). Locally these defaults point at the MinIO service in docker-compose.yml.
# In production: bucket name, region, access key, secret, the provider's S3 endpoint, and the
# public base URL that browsers load images from (a custom domain on the bucket is best).
S3_UPLOADS_BUCKET=wp-uploads
S3_UPLOADS_REGION=us-east-1
S3_UPLOADS_KEY=minio-local
S3_UPLOADS_SECRET=minio-local-secret
S3_UPLOADS_ENDPOINT=http://minio:9000
S3_UPLOADS_BUCKET_URL=https://localhost:9443/wp-uploads
# true for MinIO and other providers without per-bucket hostnames; false for AWS S3 and Cloudflare R2.
S3_UPLOADS_PATH_STYLE=true
# public-read (AWS, MinIO) or none (Cloudflare R2 and other providers that reject ACL headers).
S3_UPLOADS_OBJECT_ACL=public-read
# Host ports for the local bucket: media served over TLS by Caddy, and the MinIO console.
MEDIA_HTTPS_PORT=9443
MINIO_CONSOLE_PORT=9101

# Optional AI provider keys for core Connectors (Settings > Connectors) and the AI plugin.
# Core reads these env vars first, so keys never need to live in the database. Same names in production.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Google Tag Manager (wp-content/mu-plugins/site-gtm.php). Empty means nothing is printed,
# which is the right local default: leave it unset unless you are testing the container itself.
GTM_CONTAINER_ID=
# interaction (default) fetches gtm.js on the visitor's first move, tap, key or scroll, so it stays
# out of Lighthouse's trace entirely. immediate prints the stock snippet in the head and costs points.
GTM_LOAD_STRATEGY=interaction
# Fallback timer in ms for the interaction strategy. 0 waits for interaction and nothing else, which
# means a visitor who never interacts is never counted. A few thousand ms recovers those sessions
# and risks gtm.js landing back inside the Lighthouse trace on a slow page.
GTM_LOAD_DELAY=0
# true denies every Google consent signal until a consent platform grants it. Needed for EEA and UK
# traffic if you run Google Ads there; it keys off where visitors are, not where the company is.
# Cookiebot already emits this exact command when its Google Consent Mode tab is on, so while that
# plugin is active this variable is ignored and stays ignored. It only matters if Cookiebot goes away.
GTM_CONSENT_DEFAULTS=false
